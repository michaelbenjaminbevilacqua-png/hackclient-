{
  "name": "HackClient Dev Container",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitLens.gitlens",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "forwardPorts": [],
  "postCreateCommand": "echo 'Codespace environment ready!'"
}
